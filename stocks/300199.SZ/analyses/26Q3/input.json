  "bridge_notes": {
    "cash": "使用现金流量表期末现金等价物 1.3010002006；不使用全部货币资金 2.0562687775。差额不重复扣除。",
    "operating_cash": "1.2 亿元自主储备，约相当于前三季经营现金支出 45 天；不是披露受限现金。",
    "nonoperating_assets": "基金 1.2 为分析代理，Q3 基金单独余额 N/A；H1 三基金 1.3924043331，Q3 投资收益较 H1 减少约 0.1686。另加 Q3 权益工具和联营投资账面，投资性房地产留在经营范围，不加桥接。",
    "capex_credit": "H1 应付账款及其他应付款中工程设备款合计 0.9705530567，Q3 分拆 N/A。按 H1 代理列为债务性资本支出信用；预测 CapEx 为新投资经济支出，不重复计入旧欠款结算。",
    "minority": "合并 FCFF 对应 Q3 少数权益账面代理；H1 相关子公司亏损，公允索取权 N/A。",
    "stub": "财报日至基准日以 Q4 均匀 FCFF 减税后利息滚动。11/9 后只折现剩余 52/92，不重复计入已过 40/92。季后新增融资实际明细 N/A，未假定定增现金流入。",
    "lease": "Q3 长期租赁负债为空，短期租赁义务包含一年内到期项；预测保留租赁经济成本。"
  },
  "assumption_basis": {
    "scope": "保留已商业化及临近商业化原料药、制剂、客户肽和经营租赁；不单加 HY3003 或小核酸早期管线终值。临床研发支出仍进入正常费用，另列未估管线价值为 N/A。",
    "growth_stage": "2027—2029 为自主商业化窗口：海外已供货、仿制药申报及武汉扩产可改变该三年经营规模，无合同锁定三年高增长；2030—2033 过渡到正常竞争。",
    "growth_constraints": "API H1 收入增长 217.67%，但毛利率同比下降 9.37pct；制剂 H1 收入下降 80.88%。名义产能 10t 向 20t 扩建，产品混合和利用率不足以直接换算收入。",
    "ebit": "历史 clean_ebit 剔除补助、投资、公允价值、资产处置收益；净利息加回，减值、费用化研发及非利息财务费用保留。融资担保费与汇兑难完全分离，历史 ROIC 为保守代理。预测 EBIT 已含股份支付、正常汇兑及研发成本。",
    "tax": "预测及成熟税率 15%，以主要境内生产主体高新优惠为条件，未外推前三季 5.65% 有效税率。10%/20% 正常化税率另测；优惠续期未知。",
    "wacc": "三情景统一 11.5%，自主风险折现门槛，并非实测 CAPM。考虑集中客户、高杠杆、价格竞争及临床不确定性；10.5%—12.5% 敏感性。",
    "terminal": "g=2%，成熟 EBIT 率 18%/24%/28%，ROIC=10%/13%/16%；竞争正常化，超额回报取决于注册、质量、成本和客户持续性。",
    "capex": "含维护、武汉新扩产、其他升级和资本化研发；费用化研发留在 EBIT。DA 包含现有资本化研发摊销，不另把研发全部加回。CapEx 是经济投资，旧欠工程设备款在桥接单扣。",
    "nwc": "收入增量占款比例为 35%/30%/25%，包含经营应收、存货、长期履约成本及无息经营负债；排除桥接内旧工程设备信用及金融债务。不预设授权预收无限增长。",
    "sbc": "首次授予预计 2027/2028/2029 成本 0.783075/0.326471/0.093442，全部保留；模型另留常规激励预算，不因非现金加回。预测股数用现有 8.83241336；最大额外 0.195 亿股及对应缴款另测。"
  },
