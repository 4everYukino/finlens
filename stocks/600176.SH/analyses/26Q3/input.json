  "assumption_rationale": {
    "growth": "2027—2028 为存量高价产品及新线爬坡；2029—2033 新供给使利润率逐步正常化。收入基于粗纱、电子布与新能源综合路径，非全公司按 AI 高增。",
    "margins": "基准从 2027 34%降至成熟22%，仍高于 2024 约17%；景气、结构与效率共同解释。保留经营汇兑和股份支付。",
    "capital": "自主 CapEx 兼顾在建、冷修、贵金属及新扩产；铂金购置已包含于历史购建现金，绝不另扣。成都预算上调、低预计回报抑制无限扩张。",
    "discount": "人民币名义 WACC 9.5%，成熟规模优势与多基地周期、海外风险、杠杆共同权衡；±1pct 敏感性；g2.5%。",
    "tax": "经营税率16%，参考最近三季约16%的合并实际税负，保留海外及优惠变化风险。",
    "minority": "少数股权取30亿元自主条件估计，约TTM少数利润1.66的18倍，含海外与增长要求；非直接用15.19亿元账面值；15.19—40敏感性另列。",
    "investments": "联营投资按账面85%代理可回收价值，另加其他非流动金融资产；联营收益不在经营现金流重复计入。",
    "cash_reserve": "经营储备10亿元，接近一个月现金运营付款且对季节性留缓冲；不是全部货币资金都可分配。",
    "bridge": "中期分红实际实施值优先，Q3应付股利与实施金额差额单独保留索取权；激励股份回购义务按全部归属/全股本假设，不再次当融资债务扣减。"
  },
  "evidence_gaps": [
    "粗纱/电子布分项收入和利润率不足",
    "Q3短债/背书票据拆分缺失，以其他流动负债整体融资上限代理",
    "少数股权及联营投资无可用独立市场价",
    "新项目税前总投资收益率非IRR，完整逐期现金和IRR N/A"
  ],
